<Window x:Class="TimeTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TimeTracker.ViewModels"
        xmlns:h="clr-namespace:TimeTracker.Helpers"
        Title="TimeTracker" Width="760" Height="608"
        MinWidth="620" MinHeight="400"
        ShowInTaskbar="False"
        Closing="Window_Closing">

    <Window.Resources>
        <h:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <h:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>

        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#333"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Three-zone balance color: red = deficit, amber = met target not yet overtime, green = actual overtime -->
        <Style x:Key="BalanceText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#E65100"/>  <!-- amber: daily target met, not yet 8h -->
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDeficit}" Value="True">
                    <Setter Property="Foreground" Value="#C62828"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsActualOvertime}" Value="True">
                    <Setter Property="Foreground" Value="#2E7D32"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="#FAFAFA">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="36"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <!-- Column headers -->
        <Border Grid.Row="0" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="62"/>
                    <ColumnDefinition Width="62"/>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="62"/>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="76"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Day"      Style="{StaticResource HeaderText}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="Start"    Style="{StaticResource HeaderText}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="End"      Style="{StaticResource HeaderText}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="Break"    Style="{StaticResource HeaderText}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="5" Text="Work"     Style="{StaticResource HeaderText}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="6" Text="Overtime" Style="{StaticResource HeaderText}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Day rows -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" x:Name="DayScrollViewer">
            <ItemsControl ItemsSource="{Binding DayRows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DayRowViewModel}">
                        <StackPanel>
                            <Border Height="2" Background="#BDBDBD"
                                    Visibility="{Binding IsWeekStart, Converter={StaticResource BoolToVis}}"/>

                            <Border BorderBrush="#E8E8E8" BorderThickness="0,0,0,1" Padding="8,5">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="White"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWeekend}" Value="True">
                                                <Setter Property="Background" Value="#F2F2F2"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsHoliday}" Value="True">
                                                <Setter Property="Background" Value="#FFF8E1"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                <Setter Property="Background" Value="#E3F2FD"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsOutOfMonth}" Value="True">
                                                <Setter Property="Background" Value="#EEEEEE"/>
                                                <Setter Property="Opacity" Value="0.5"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="62"/>
                                        <ColumnDefinition Width="62"/>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="62"/>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="76"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding DateLabel}"
                                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding WeekdayLabel}"
                                               Foreground="#888" FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding StartDisplay}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding EndDisplay}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{Binding BreakDisplay}"
                                               Foreground="#888" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="5" Text="{Binding WorkDisplay}"
                                               FontWeight="SemiBold" VerticalAlignment="Center"/>

                                    <!-- Overtime/balance column: red=deficit, amber=met not overtime, green=overtime -->
                                    <TextBlock Grid.Column="6" Text="{Binding BalanceDisplay}"
                                               Style="{StaticResource BalanceText}"/>

                                    <TextBlock Grid.Column="7" Text="{Binding HolidayName}"
                                               Foreground="#E65100" FontSize="11" FontStyle="Italic"
                                               VerticalAlignment="Center" Margin="4,0,0,0"
                                               Visibility="{Binding IsHoliday, Converter={StaticResource BoolToVis}}"/>

                                    <StackPanel Grid.Column="8" Orientation="Horizontal"
                                                VerticalAlignment="Center" HorizontalAlignment="Right"
                                                Visibility="{Binding IsOutOfMonth, Converter={StaticResource InvBoolToVis}}">
                                        <Button Content="Edit" Style="{StaticResource ActionButton}"
                                                Command="{Binding EditCommand}"
                                                Background="#E3F2FD" Foreground="#1565C0"
                                                Visibility="{Binding HasEntry, Converter={StaticResource BoolToVis}}"
                                                Margin="0,0,3,0"/>
                                        <Button Content="Add" Style="{StaticResource ActionButton}"
                                                Command="{Binding EditCommand}"
                                                Background="#E8F5E9" Foreground="#2E7D32"
                                                Visibility="{Binding HasEntry, Converter={StaticResource InvBoolToVis}}"
                                                Margin="0,0,3,0"/>
                                        <Button Content="Del" Style="{StaticResource ActionButton}"
                                                Command="{Binding DeleteCommand}"
                                                Background="#FFEBEE" Foreground="#C62828"
                                                Visibility="{Binding HasEntry, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Monthly summary -->
        <Border Grid.Row="2" Background="#EEEEEE" BorderBrush="#DDDDDD" BorderThickness="0,1,0,1">
            <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding MonthlySummary}" FontSize="12" Foreground="#444"/>
                <TextBlock Text="{Binding MonthlyBalanceDisplay}" FontSize="12" FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#2E7D32"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMonthlyBalanceNegative}" Value="True">
                                    <Setter Property="Foreground" Value="#C62828"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="  /  Total overtime: " FontSize="12" Foreground="#444"/>
                <TextBlock Text="{Binding TotalOvertimeDisplay}" FontSize="12" FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#2E7D32"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTotalOvertimeNegative}" Value="True">
                                    <Setter Property="Foreground" Value="#C62828"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="  /  Vacation: " FontSize="12" Foreground="#444"
                           Visibility="{Binding HasVacationConfig, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding VacationBalanceDisplay}" FontSize="12" FontWeight="SemiBold"
                           Foreground="#1565C0"
                           Visibility="{Binding HasVacationConfig, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Border>

        <!-- Timer bar -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="▶  Start" Width="110" Height="40"
                        Command="{Binding StartCommand}"
                        Background="#43A047" Foreground="White" FontSize="14" FontWeight="Bold"
                        BorderThickness="0" Cursor="Hand"
                        Visibility="{Binding IsTracking, Converter={StaticResource InvBoolToVis}}"/>
                <Button Grid.Column="0" Content="■  Stop" Width="110" Height="40"
                        Command="{Binding StopCommand}"
                        Background="#E53935" Foreground="White" FontSize="14" FontWeight="Bold"
                        BorderThickness="0" Cursor="Hand"
                        Visibility="{Binding IsTracking, Converter={StaticResource BoolToVis}}"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0"
                            Visibility="{Binding IsTracking, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Elapsed: " Foreground="#888" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ElapsedDisplay}" FontSize="16" FontWeight="Bold"
                               Foreground="#333" Margin="0,0,24,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Overtime: " Foreground="#888" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding BalanceTodayDisplay}" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#E65100"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTodayDeficit}" Value="True">
                                        <Setter Property="Foreground" Value="#C62828"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsTodayActualOvertime}" Value="True">
                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="Press Start to begin tracking"
                           Foreground="#AAAAAA" FontStyle="Italic" FontSize="13"
                           VerticalAlignment="Center" Margin="16,0,0,0"
                           Visibility="{Binding IsTracking, Converter={StaticResource InvBoolToVis}}"/>

                <!-- Month navigation + Export on the right -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource NavButton}" Content="&#x2039;"
                            Command="{Binding PreviousMonthCommand}"/>
                    <TextBlock Text="{Binding MonthTitle}"
                               FontSize="15" FontWeight="Bold" Foreground="#222"
                               VerticalAlignment="Center" MinWidth="130" TextAlignment="Center"
                               Cursor="Hand"
                               ToolTip="Go to current month">
                        <TextBlock.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding GoToCurrentMonthCommand}"/>
                        </TextBlock.InputBindings>
                    </TextBlock>
                    <Button Style="{StaticResource NavButton}" Content="&#x203a;"
                            Command="{Binding NextMonthCommand}" IsEnabled="{Binding CanNavigateNext}"/>
                    <Button Content="Export" Margin="8,0,0,0"
                            Command="{Binding ExportCommand}" Padding="14,6"
                            Background="#1976D2" Foreground="White" FontWeight="SemiBold"
                            BorderThickness="0" VerticalAlignment="Center" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
